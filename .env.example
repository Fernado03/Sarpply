# Optional: point the app and scripts at an existing PostgreSQL 16 server.
# Without these, the embedded PostgreSQL cluster under .pg/ is used.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/sarpply
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/sarpply_test

# WhatsApp transport. `fake` (the default) records messages without a network
# call; `cloud` uses the WhatsApp Cloud API.
# WHATSAPP_PROVIDER=fake
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v23.0
# Inbound webhook: Meta signs the raw body with the app secret, and the
# subscription handshake compares this verify token.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
